msgstr "ගවේෂකයක JUPOS ව්‍යාපෘතිය විවෘත කරයි"

msgid "Opposition of"
msgstr "ප්‍රතිරෝධ"

msgid "Oppositions"
msgstr "ප්‍රතිරෝධ"

msgid "Orbit colors"
msgstr "කක්ෂ වර්ණ"

msgid "Orbital periods ratio"
msgstr "කක්ෂ කාල අනුපාතය"

msgid "Orbital velocity"
msgstr "කක්ෂ ප්‍රවේගය"

msgid "Orbits"
msgstr "කක්ෂ"

msgid "Orbits of Oort cloud objects"
msgstr "ඕර්ට් වලාවතා වස්තු කක්ෂ"

msgid "Orbits of comets"
msgstr "ධුමකේතු කක්ෂ"

msgid "Orbits of cubewanos"
msgstr "cubewano කක්ෂ"

msgid "Orbits of dwarf planets"
msgstr "අයිනි ග්‍රහයන් කක්ෂ"

msgid "Orbits of interstellar objects"
msgstr "අතර තාරකා වස්තු කක්ෂ"

msgid "Orbits of major planets"
msgstr "ප්‍රධාන ග්‍රහයන්ගේ කක්ෂ"

msgid "Orbits of minor planets"
