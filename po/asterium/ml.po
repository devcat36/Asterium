msgid "Adjust brightness to bright objects"
msgstr "തെളിച്ച വസ്തുക്കളുടെ ദൃശ്യപ്രകാശം ക്രമീകരിക്കുക"

msgid "Algol-type eclipsing systems"
msgstr "ഓൾഗോൾ തരത്തിലുള്ള ഗ്രാസകാരി നക്ഷത്രപ്രണാലികൾ"

