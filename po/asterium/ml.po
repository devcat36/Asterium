msgid "%d bodies"
msgstr "%d ആകാശവസ്തുക്കൾ"

msgid "%d object"
msgstr "%d വസ്തു"

msgid "%d objects"
msgstr "%d വസ്തുക്കൾ"

msgid "%s colour"
msgstr "%s നിറം"

msgid "%s from %s, ±%.0f m"
msgstr "%s നിന്നും %s, ±%.0f മീ"

msgid "12-hour"
msgstr "12 മണിക്കൂര്‍"

msgid "12h"
msgstr "12മ"

msgid "1× below"
msgstr "1× താഴെ"

msgid "24-hour"
msgstr "24 മണിക്കൂര്‍"

