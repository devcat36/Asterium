msgid "Almanac"
msgstr "കാലപഞ്ജിക"

msgid "Almanac: Sun, Moon and naked-eye planets"
msgstr "പഞ്ചാംഗം: സൂര്യൻ, ചന്ദ്രൻ, നഗ്നനേത്രദ്വാരാ കാണുന്ന ഗ്രഹങ്ങൾ"

msgid "Also find"
msgstr "കൂടാതെ തിരയുക"

